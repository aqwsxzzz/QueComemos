# Copy to .env for running the API outside docker compose.
# Inside docker compose these are supplied by the app service.

DATABASE_URL=postgresql+asyncpg://quecomemos:quecomemos@db:5432/quecomemos
TEST_DATABASE_URL=postgresql+asyncpg://quecomemos:quecomemos@db:5432/quecomemos_test

JWT_SECRET=dev-secret-change-me
DEBUG=false

ALLOWED_ORIGINS=http://localhost:5173

# Dev: MinIO from docker compose. Prod: Cloudflare R2 — same S3 API, only these change.
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_ACCESS_KEY=quecomemos
STORAGE_SECRET_KEY=quecomemos-dev-secret
STORAGE_BUCKET=quecomemos-media
STORAGE_REGION=auto
